# OCI account information
OCI_CLI_TENANCY=YOUR_TENANCY_OCID
OCI_CLI_USER=YOUR_USER_OCID
OCI_CLI_FINGERPRINT=YOUR_API_KEY_FINGERPRINT
OCI_CLI_REGION=ap-mumbai-1

# Infrastructure
OCI_COMPARTMENT_ID=YOUR_ROOT_COMPARTMENT_OCID
OCI_SUBNET_ID=YOUR_PUBLIC_SUBNET_OCID

# Local private API key file (never commit this file)
OCI_API_KEY_FILE=~/.oci/oci_api_key.pem

# SSH public key only (never put your private SSH key here)
OCI_SSH_PUBLIC_KEY="ssh-ed25519 YOUR_PUBLIC_KEY"
